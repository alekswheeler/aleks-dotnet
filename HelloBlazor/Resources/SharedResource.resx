  <data name="Pokedex_Title" xml:space="preserve">
    <value>AI Pokédex</value>
  </data>
  <data name="Pokedex_Subtitle" xml:space="preserve">
    <value>Point the camera at any Pokémon and let the model tell you who's that Pokémon — with C# running the ML model for inference, from the API to the screen.</value>
  </data>
  <data name="Pokedex_CtaRepo" xml:space="preserve">
