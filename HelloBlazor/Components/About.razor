<section class="light" id="about">
    @if (hero is not null)
    {
        <img class="background" src="@(hero.Src)" alt="@(hero.Alt)" />
    }
    <h2>@L["About_Title"]</h2>
    <div class="teste" style="background-color: white; padding: 4rem; margin: 3rem auto; text-align: center;">
    @if (aboutMe is null)
    {
        <p><em>@L["Common_Loading"]</em></p>
    }
    else
    {
        <p class="large">@aboutMe.Description</p>

        <hr />
        <p>@aboutMe.DetailOrQuote</p>
    }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    [Parameter, EditorRequired]
    public required HeroImageService HeroImageService { get; set; }

    [Inject]
    public required IStringLocalizer<SharedResource> L { get; set; }

    private AboutMe? aboutMe;
    private HeroImage? hero;

    protected override async Task OnInitializedAsync()
    {
        var path = CultureInfo.CurrentUICulture.Name.StartsWith("pt", StringComparison.OrdinalIgnoreCase)
            ? "sample-data/aboutme.pt-BR.json"
            : "sample-data/aboutme.json";
        aboutMe = await Http.GetFromJsonAsync<AboutMe>(path);
        hero = await HeroImageService.GetHeroAsync(img => img.Name is "about");
    }
}
