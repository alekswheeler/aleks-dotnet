  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web, Android, iOS",
  "inLanguage": "pt-BR",
  "url": "https://aleks.qzz.io/dropbook",
  "featureList": [
    "Confirmação de clientes automática",
    "Lembretes automáticos que derrubam as faltas de última hora",
    "Agenda no celular, onde você estiver",
    "Acesso por ordem de pedido: quem pede primeiro entra primeiro",
    "Cancele quando quiser, sem compromisso",
    "Configuração em minutos, sem técnico"
  ]
}
</script>

