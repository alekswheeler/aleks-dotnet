@page "/apsstudio"
@implements IAsyncDisposable
@inject IJSRuntime JS

<HeadContent>
    <meta name="description" content="Conheça o APS Studio: programação automática, ajustes no Gantt, proteção de operações firmadas e clareza para decidir no PCP." />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#10253b" />
</HeadContent>

<PageTitle>APS Studio — produção planejada, PCP no controle</PageTitle>

<div class="apsstudio-page" @ref="_root">
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

    <header class="site-header">
        <div class="wrap header-inner">
            <a class="brand" href="#inicio" aria-label="APS Studio, início">
                <span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="brand-text">APS <span>Studio</span></span>
            </a>
            <button class="menu-toggle" id="menuToggle" type="button" aria-label="Abrir navegação" aria-expanded="false" aria-controls="navigation">☰</button>
            <nav class="nav" id="navigation" aria-label="Principal">
                <a href="#diferenciais">Por que APS Studio</a>
                <a href="#na-pratica">Na prática</a>
                <a href="#duvidas">Dúvidas</a>
                <a class="btn btn-primary nav-cta" href="#demonstracao">Solicitar demonstração <span aria-hidden="true">↗</span></a>
            </nav>
        </div>
    </header>

    <main id="conteudo">
        <section class="hero" id="inicio">
            <div class="wrap hero-inner">
                <div class="hero-copy">
                    <p class="eyebrow">Planejamento e programação da produção</p>
                    <h1>A fábrica muda.<br />O controle do plano <em>continua com você.</em></h1>
                    <p class="hero-lead">Sequencie automaticamente, ajuste o Gantt e entenda os conflitos. Preserve operações firmadas e avalie o impacto de cada mudança antes de confirmar a programação.</p>
                    <div class="actions">
                        <a class="btn btn-primary" href="#demonstracao">Quero avaliar meu cenário <span class="arrow" aria-hidden="true">↗</span></a>
                        <a class="btn btn-secondary" href="#na-pratica">Explorar um exemplo <span aria-hidden="true">↓</span></a>
                    </div>
                    <div class="hero-foot"><span>Capacidade finita</span><span>Interface em português</span><span>Controle do PCP</span></div>
                </div>

                <div class="workspace" id="demo-interativo" aria-label="Exemplo ilustrativo de replanejamento">
                    <div class="work-title">
                        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
                        <strong>Um pedido urgente. E agora?</strong>
                        <span class="work-tag">EXEMPLO ILUSTRATIVO</span>
                    </div>
                    <div class="workspace-nav" role="group" aria-label="Etapas do exemplo">
                        <button class="step-btn" type="button" data-step="base" aria-pressed="true"><span>01</span> Plano atual</button>
                        <button class="step-btn" type="button" data-step="urgent" aria-pressed="false"><span>02</span> Pedido urgente</button>
                        <button class="step-btn" type="button" data-step="repaired" aria-pressed="false"><span>03</span> Proposta de ajuste</button>
                    </div>
                    <div class="schedule-scroll">
                        <div class="schedule">
                            <svg id="schedule" viewBox="0 0 580 235" role="img" aria-labelledby="scheduleTitle scheduleDesc">
                                <title id="scheduleTitle">Programação ilustrativa por recurso</title>
                                <desc id="scheduleDesc">Uma operação firmada permanece protegida. As etapas do exemplo mostram uma nova demanda e uma proposta de reorganização.</desc>
                            </svg>
                        </div>
                    </div>
                    <div class="schedule-key"><span><i class="key-square locked"></i>Operação firmada</span><span><i class="key-square"></i>Programação atual</span><span><i class="key-square orange"></i>Nova demanda</span></div>
                    <div class="result-strip"><div><b id="commitmentMetric">1</b>compromisso protegido</div><div><b id="changeMetric" class="accent">0</b><span id="changeLabel">alterações propostas</span></div></div>
                    <div class="schedule-status" id="scheduleStatus" data-state="base" role="status" aria-live="polite"><i class="status-dot" aria-hidden="true"></i><span id="scheduleMessage">O plano contém uma operação firmada. Ela será preservada ao avaliar a nova demanda.</span></div>
                    <div class="work-note"><strong>Ilustração interativa com dados fictícios.</strong> A programação real depende dos dados, das regras e das restrições configuradas na sua modelagem.</div>
                </div>
            </div>
            <div class="wrap hero-bottom"><strong>Um APS para quem precisa explicar e conduzir o plano.</strong><div class="scenarios"><span>PCP</span><span>Gestão industrial</span><span>Planejamento de capacidade</span></div></div>
        </section>

        <section class="section difference" id="diferenciais">
            <div class="wrap difference-layout">
                <div class="difference-intro">
                    <p class="eyebrow">Por que APS Studio</p>
                    <h2>Controle para o PCP.<br />Clareza para a decisão.</h2>
                    <p class="lead">Uma boa programação precisa fazer sentido para quem vai trabalhar com ela. O APS Studio combina automação, intervenção manual e validação no mesmo fluxo de planejamento.</p>
                    <div class="note-card">Avalie esses recursos na prática: quais compromissos ficam protegidos, o que pode mudar e quais conflitos precisam da sua decisão.</div>
                </div>
                <div class="differentials">
                    <article class="differential"><span class="diff-num">01</span><div><h3>Replaneje com respeito ao que já foi combinado.</h3><p>Firme operações para preservar horários, recursos e reservas. Ao surgir uma nova restrição, os conflitos com esses compromissos são apresentados para tratamento, em vez de deslocá-los silenciosamente.</p><span class="proof-line">Operações firmadas e apontamentos reais protegidos.</span></div></article>
                    <article class="differential"><span class="diff-num">02</span><div><h3>Automatize sem perder a intervenção do planejador.</h3><p>Gere a programação, revise as operações no Gantt e faça os ajustes permitidos. Escolha o escopo da próxima rodada e use as funções de validação e correção para conferir os efeitos.</p><span class="proof-line">Programação automática, edição e correção no mesmo processo.</span></div></article>
                    <article class="differential"><span class="diff-num">03</span><div><h3>Entenda os bloqueios antes de decidir.</h3><p>Uma operação ficou sem programação? Consulte os motivos e os relatórios de conflitos e materiais. Identifique o que impede o encaixe e avalie como tratar o problema.</p><span class="proof-line">Status, motivos e relatórios para orientar a análise.</span></div></article>
                    <article class="differential"><span class="diff-num">04</span><div><h3>Guarde o contexto de cada alternativa.</h3><p>Salve cenários com sua programação, configurações e estado de alocação. Compare alternativas da mesma fábrica antes de escolher a versão que pretende manter.</p><span class="proof-line">Cenários identificados para simular e retomar o trabalho.</span></div></article>
                </div>
            </div>
        </section>

        <section class="section reality" id="na-pratica">
            <div class="wrap reality-layout">
                <div class="reality-copy">
                    <p class="eyebrow">A realidade entra no modelo</p>
                    <h2>Uma operação pode precisar de muito mais que uma máquina livre.</h2>
                    <p class="lead">Represente as condições que influenciam o seu plano e confira a programação com as restrições selecionadas.</p>
                    <ul class="constraint-list">
                        <li><strong>Recursos que precisam trabalhar juntos.</strong>Máquinas, equipes, ferramentas e outros recursos, com suas capacidades e calendários.</li>
                        <li><strong>Materiais com quantidade e data.</strong>Consulte reservas, faltas e dependências entre operações para avaliar o que pode ser programado.</li>
                        <li><strong>Roteiros e quantidades por etapa.</strong>Modele unidades, taxas, precedências e necessidades de produção conforme o seu processo.</li>
                    </ul>
                </div>
                <div class="model-visual">
                    <div class="model-kicker">Exemplo de uma regra de produção</div>
                    <div class="operation-node"><div class="overline">OPERAÇÃO · 20</div><strong>Preparar e processar o lote</strong><p>O encaixe depende das condições configuradas para a operação.</p></div>
                    <div class="connector" aria-hidden="true"></div>
                    <div class="resources">
                        <div class="resource"><span class="resource-icon" aria-hidden="true">▤</span><strong>Máquina</strong><small>Calendário e capacidade</small></div>
                        <div class="resource"><span class="resource-icon" aria-hidden="true">♙</span><strong>Equipe</strong><small>Disponibilidade</small></div>
                        <div class="resource"><span class="resource-icon" aria-hidden="true">⌘</span><strong>Ferramenta</strong><small>Recurso necessário</small></div>
                    </div>
                    <div class="availability"><i aria-hidden="true"></i>A programação considera os recursos exigidos em cada fase.</div>
                    <p class="model-foot">Estrutura ilustrativa. Recursos de setup e de produção podem ter necessidades diferentes na modelagem.</p>
                </div>
            </div>
        </section>

        <section class="section decisions">
            <div class="wrap">
                <div class="section-head"><p class="eyebrow">A diferença aparece na rotina</p><h2>Quatro perguntas que o seu PCP precisa conseguir responder.</h2><p>Use a demonstração para avaliar o fluxo de trabalho, além da aparência do Gantt.</p></div>
                <table class="decision-table">
                    <thead><tr><th>Decisão do planejador</th><th>Como o APS Studio ajuda</th></tr></thead>
                    <tbody>
                        <tr><td>O que já está comprometido?</td><td><b>Proteja a programação firmada.</b> Consulte os travamentos e os apontamentos antes de reorganizar as operações.</td></tr>
                        <tr><td>O que posso mudar nesta rodada?</td><td><b>Defina o escopo do sequenciamento.</b> Trabalhe nas operações selecionadas e nas relações necessárias ao planejamento.</td></tr>
                        <tr><td>Por que uma ordem não encontrou espaço?</td><td><b>Consulte motivos e conflitos.</b> Analise recursos, materiais e condições que impedem a programação.</td></tr>
                        <tr><td>Qual alternativa faz mais sentido?</td><td><b>Salve e compare cenários.</b> Reveja os impactos em prazos, programação e utilização dos recursos antes de confirmar sua escolha.</td></tr>
                    </tbody>
                </table>
                <p class="decision-foot">A viabilidade do plano depende da qualidade dos dados e das restrições efetivamente configuradas e validadas.</p>
            </div>
        </section>

        <section class="section process" id="demonstrar">
            <div class="wrap">
                <div class="process-head"><div><p class="eyebrow">Uma conversa com contexto</p><h2>Comece pelo cenário que você precisa resolver.</h2></div><a class="btn btn-secondary" href="#demonstracao">Solicitar uma demonstração <span aria-hidden="true">↗</span></a></div>
                <div class="process-steps">
                    <article class="process-step"><span class="number">01 / CONTEXTO</span><h3>Conte onde o plano encontra dificuldade.</h3><p>Um recurso disputado, uma mudança frequente ou uma ordem que sempre exige ajuste. Começamos entendendo esse problema.</p></article>
                    <article class="process-step"><span class="number">02 / MODELAGEM</span><h3>Veja como as regras entram no planejamento.</h3><p>Exploramos os dados e as condições necessários para representar recursos, operações, calendários e materiais do cenário.</p></article>
                    <article class="process-step"><span class="number">03 / DECISÃO</span><h3>Avalie o fluxo de programação.</h3><p>Confira o Gantt, os bloqueios e as alternativas. A conversa ajuda a definir o escopo e os próximos passos para sua operação.</p></article>
                </div>
                <div class="fit-strip"><strong>Faz sentido para a sua fábrica?</strong><p>O APS Studio é voltado a operações com recursos limitados, múltiplas etapas e necessidade de replanejar. A aderência e o escopo devem ser avaliados com o seu processo.</p></div>
            </div>
        </section>

        <section class="section faq-section" id="duvidas">
            <div class="wrap faq-layout">
                <div><p class="eyebrow">Antes de conversar</p><h2>O que vale saber desde o começo.</h2><p class="lead">Uma avaliação objetiva começa com expectativas claras sobre dados, integração e uso.</p></div>
                <div class="faq-list">
                    <details><summary>Preciso trocar o ERP?</summary><p>O APS Studio trabalha com dados de planejamento e pode complementar o ERP. A integração disponível usa uma origem SQL configurada; os dados e o fluxo de atualização precisam ser avaliados no projeto. Compatibilidade com um ERP específico deve ser confirmada na demonstração.</p></details>
                    <details><summary>Posso ajustar a programação manualmente?</summary><p>Sim. O Gantt permite ajustes nas operações que podem ser alteradas. Operações firmadas e apontamentos reais têm proteção própria. Depois das alterações, as funções de validação e correção ajudam a conferir a programação.</p></details>
                    <details><summary>O sistema trata materiais e recursos auxiliares?</summary><p>A modelagem pode considerar recursos auxiliares, calendários, necessidades e alocação de materiais. Esses dados e suas políticas precisam ser configurados. Os relatórios ajudam a consultar reservas, faltas e dependências do cenário.</p></details>
                    <details><summary>Como funciona o acesso ao aplicativo?</summary><p>O APS Studio é um aplicativo desktop, com interface em português e integração com SQL Server. O ambiente e os requisitos de implantação são avaliados conforme o uso pretendido.</p></details>
                    <details><summary>Posso avaliar com um problema da minha produção?</summary><p>Conte o cenário que deseja explorar e os dados que já possui. A partir disso, combinamos o escopo da demonstração e o que é necessário preparar. <a href="#demonstracao">Enviar meu contexto para a conversa.</a></p></details>
                </div>
            </div>
        </section>

        <section class="section contact" id="demonstracao">
            <div class="wrap contact-layout">
                <div class="contact-copy">
                    <p class="eyebrow">Vamos olhar para a sua produção</p>
                    <h2>Traga uma decisão difícil.<br />Vamos explorar o cenário.</h2>
                    <p class="lead">Conte o que hoje exige mais esforço do PCP. Vamos conversar sobre como esse problema pode ser representado no APS Studio.</p>
                    <ul class="contact-list"><li>Quais recursos e restrições importam para o seu plano.</li><li>Como você programa e trata mudanças hoje.</li><li>O que precisa conseguir avaliar em uma demonstração.</li></ul>
                    <div class="contact-email">Prefere começar diretamente por e-mail?<br /><a href="mailto:mttursini@gmail.com?subject=Demonstra%C3%A7%C3%A3o%20APS%20Studio">mttursini@gmail.com ↗</a></div>
                </div>
                <form class="lead-form" id="demoForm">
                    <h3>Conte um pouco do seu cenário</h3>
                    <p>Prepare uma mensagem para solicitar a demonstração.</p>
                    <div class="form-pair">
                        <div class="field"><label for="leadName">Seu nome</label><input id="leadName" name="nome" autocomplete="name" required maxlength="100" /></div>
                        <div class="field"><label for="leadCompany">Empresa</label><input id="leadCompany" name="empresa" autocomplete="organization" required maxlength="160" /></div>
                    </div>
                    <div class="field"><label for="leadEmail">E-mail de contato</label><input id="leadEmail" name="email" type="email" autocomplete="email" required maxlength="180" /></div>
                    <div class="field"><label for="leadChallenge">Qual é o principal desafio? <small>Opcional</small></label><textarea id="leadChallenge" name="desafio" maxlength="1800" placeholder="Ex.: encaixar pedidos urgentes sem reorganizar toda a programação."></textarea></div>
                    <button class="btn btn-primary submit-btn" type="submit">Preparar pedido de demonstração <span aria-hidden="true">↗</span></button>
                    <p class="form-note">Seu programa de e-mail será aberto com a mensagem pronta para você revisar e enviar.</p>
                    <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
                </form>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="wrap footer-inner">
            <a class="brand" href="#inicio" aria-label="APS Studio, voltar ao início"><span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i></span><span class="brand-text">APS <span>Studio</span></span></a>
            <span>Planejamento e programação da produção · 2026</span>
            <div class="footer-links"><a href="#diferenciais">Diferenciais</a><a href="#duvidas">Dúvidas</a><a href="#demonstracao">Demonstração</a></div>
        </div>
    </footer>
</div>

@code {
    private ElementReference _root;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/apsstudio/index.js");
            await _module.InvokeVoidAsync("init", _root);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("destroy", _root);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
