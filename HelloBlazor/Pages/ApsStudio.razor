</div>

@code {
    private const string _dcProps = "{\"$preview\":{\"width\":1280,\"height\":4600}}";
    private ElementReference _root;
    private IJSObjectReference? _module;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/apsstudio/index.js");
            await JS.InvokeVoidAsync("apsstudioInit", _root);
            _initialized = true;
        }
        catch
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_initialized)
                await JS.InvokeVoidAsync("apsstudioDestroy");
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch
        {
        }
    }
}